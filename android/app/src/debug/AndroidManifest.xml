<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only manifest overlay: the U6 playback harness. Not present in release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          adb shell am start -n app.playlistplayer/.DebugPlaybackActivity with string extra "url"
          (see DebugPlaybackActivity KDoc for all extras).
          Not exported: only the app itself (or run-as / a userdebug shell) can start it.
        -->
        <activity
            android:name=".DebugPlaybackActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false" />
    </application>

</manifest>
